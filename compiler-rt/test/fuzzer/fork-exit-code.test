# The -fork parent exits with the exit code of the child that stopped it,
# decoded from the child's wait status on every platform.
# UNSUPPORTED: target={{.*freebsd.*}}
RUN: %cpp_compiler %S/SimpleTest.cpp -o %t-SimpleTest
RUN: not %run %t-SimpleTest -fork=1 2>&1 | FileCheck %s
CHECK: BINGO
CHECK: INFO: exiting: 77 time:
